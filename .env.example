# 复制为 .env 后再启动服务；请勿提交真实 .env。

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=flame_sport_pheno
MYSQL_USER=flame
MYSQL_PASSWORD=replace-with-strong-app-password
MYSQL_PORT=13306

# 客户端后端
APP_MODE=production
DB_ECHO=false
BACKEND_PORT=18000
AUTH_CACHE_TTL_SECONDS=7200
AUTH_CACHE_CLEANUP_INTERVAL_SECONDS=300
SEASON_PARTICIPATION_ALLOWED_DAYS=7
IMAGE_CACHE_MAX_AGE_SECONDS=1204800

# 钉钉登录
DINGTALK_CLIENT_ID=replace-with-dingtalk-client-id
DINGTALK_CLIENT_SECRET=replace-with-dingtalk-client-secret
DINGTALK_AGENT_ID=replace-with-dingtalk-agent-id
DINGTALK_HTTP_TIMEOUT_SECONDS=5
DINGTALK_ACCESS_TOKEN_REFRESH_INTERVAL_SECONDS=300
DINGTALK_ACCESS_TOKEN_REFRESH_SKEW_SECONDS=300
DINGTALK_NOTIFICATION_CHECK_INTERVAL_SECONDS=60

# 大模型初审；未配置密钥时应保持关闭。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_HTTP_TIMEOUT_SECONDS=60
LLM_PRELIMINARY_REVIEW_ENABLED=false
LLM_PRELIMINARY_REVIEW_INTERVAL_SECONDS=900
LLM_PRELIMINARY_REVIEW_MIN_AGE_SECONDS=300

# 排行榜刷新
LEADERBOARD_REFRESH_ENABLED=true
LEADERBOARD_REFRESH_ON_STARTUP=true
LEADERBOARD_REFRESH_INTERVAL_SECONDS=900

# 赛季共享配置：同时注入客户后端、管理端后端和客户前端构建。
ACTIVE_SEASON_CONFIG_EDIT_WINDOW_HOURS=24

# 客户端前端
FRONTEND_PORT=18080
VUE_APP_API_BASE_URL=/flame/api
VUE_APP_SHOP_REDEEM_WINDOW_DAYS=7
VUE_APP_PAGE_TITLE=燃动现象
VUE_APP_DINGTALK_CORP_ID=replace-with-dingtalk-corp-id
VUE_APP_DINGTALK_CLIENT_ID=replace-with-dingtalk-client-id

# 管理端后端
MANAGE_BACKEND_PORT=18001
MANAGE_APP_NAME=燃动现象管理端后端
MANAGE_APP_ENV=production
MANAGE_APP_DEBUG=false
MANAGE_CORS_ORIGINS=[]
MANAGE_ADMIN_KEY=replace-with-strong-admin-key
MANAGE_ADMIN_TOKEN_TTL_SECONDS=28800
MANAGE_ADMIN_TOKEN_CACHE_MAX_SIZE=1000
MANAGE_MYSQL_CHARSET=utf8mb4
MANAGE_MYSQL_ECHO=false
MANAGE_MYSQL_POOL_SIZE=5
MANAGE_MYSQL_MAX_OVERFLOW=5
MANAGE_MYSQL_POOL_RECYCLE_SECONDS=1800
MANAGE_CLIENT_BACKEND_BASE_URL=http://backend:8000/flame/api/admin
MANAGE_CLIENT_BACKEND_TIMEOUT_SECONDS=10
MANAGE_IMAGE_CACHE_SECONDS=1204800

# 管理端赛季状态检查与结算
MANAGE_SEASON_STATUS_CHECK_ENABLED=true
MANAGE_SEASON_STATUS_CHECK_INTERVAL_SECONDS=60
MANAGE_SEASON_SETTLEMENT_REVIEW_BATCH_SIZE=100
MANAGE_SEASON_SETTLEMENT_REVIEW_CONCURRENCY=5
MANAGE_SEASON_SETTLEMENT_USER_BATCH_SIZE=100
MANAGE_SEASON_SETTLEMENT_AUTO_COMPLETE_ENABLED=true
MANAGE_SEASON_SETTLEMENT_AUTO_COMPLETE_AFTER_DAYS=5
MANAGE_SEASON_SETTLEMENT_TWO_MONTH_STREAK_BONUS_POINTS=50
MANAGE_SEASON_SETTLEMENT_THREE_MONTH_STREAK_BONUS_POINTS=100

# 管理端查询智能体：控制单次模型生成、工具循环与进程内会话资源上限。
DEEPSEEK_QUERY_ALIGNMENT_MAX_TOKENS=1200
DEEPSEEK_QUERY_PLANNING_MAX_TOKENS=3000
DEEPSEEK_QUERY_INSPECTION_MAX_TOKENS=800
DEEPSEEK_QUERY_SQL_MAX_TOKENS=1200
DEEPSEEK_QUERY_TRANSLATION_MAX_TOKENS=1000
DEEPSEEK_QUERY_AUDIT_MAX_TOKENS=500
AGENT_QUERY_ALIGNMENT_MAX_GENERATIONS=10
AGENT_QUERY_PLANNING_MAX_GENERATIONS=30
AGENT_QUERY_PLANNING_MAX_TOOL_CALLS=30
AGENT_QUERY_SQL_MAX_GENERATIONS=4
AGENT_QUERY_TRANSLATION_MAX_PARALLEL_FIELDS=4
AGENT_QUERY_MAX_ACTIVE_SESSIONS=20
AGENT_QUERY_EVENT_HISTORY_SIZE=200
AGENT_QUERY_SESSION_TTL_SECONDS=3600
AGENT_QUERY_SSE_HEARTBEAT_SECONDS=15

# 管理端前端
MANAGE_FRONTEND_PORT=18081
MANAGE_APP_BASE_PATH=/flame/admin/
MANAGE_API_BASE_PATH=/flame/admin/api
